# ===========================================
# HuaShui AI Backend Environment Variables
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# DeepSeek AI API
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Database Configuration
# For local development (SQLite - no configuration needed)
# Database file will be created automatically as database.sqlite

# For Production (PostgreSQL)
# Uncomment and fill these for production:
# DATABASE_URL=postgresql://username:password@host:port/database_name

# Example DATABASE_URL formats:
# Railway: postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway
# Render: postgresql://user:pass@host.render.com:5432/dbname
# Supabase: postgresql://postgres:password@db.project.supabase.co:5432/postgres
# Neon: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Logging Level
LOG_LEVEL=info
